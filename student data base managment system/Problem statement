#include <iostream>
#include <string>
using namespace std;

// Node structure
struct Student
{
    int rollNo;
    string name;
    float marks;
    Student* next;
};

// Head pointer
Student* head = nullptr;

// Function to insert student
void insertStudent()
{
    Student* newNode = new Student;

    cout << "\nEnter Roll Number: ";
    cin >> newNode->rollNo;

    cout << "Enter Student Name: ";
    cin.ignore();
    getline(cin, newNode->name);

    cout << "Enter Marks: ";
    cin >> newNode->marks;

    newNode->next = nullptr;

    // If list is empty
    if (head == nullptr)
    {
        head = newNode;
    }
    else
    {
        Student* temp = head;

        while (temp->next != nullptr)
        {
            temp = temp->next;
        }

        temp->next = newNode;
    }

    cout << "\nStudent record inserted successfully!\n";
}

// Function to delete student
void deleteStudent()
{
    if (head == nullptr)
    {
        cout << "\nStudent list is empty!\n";
        return;
    }

    int rollNo;

    cout << "\nEnter Roll Number to delete: ";
    cin >> rollNo;

    Student* temp = head;
    Student* prev = nullptr;

    // Search student
    while (temp != nullptr && temp->rollNo != rollNo)
    {
        prev = temp;
        temp = temp->next;
    }

    // Student not found
    if (temp == nullptr)
    {
        cout << "\nStudent record not found!\n";
        return;
    }

    // Delete first node
    if (prev == nullptr)
    {
        head = temp->next;
    }
    else
    {
        prev->next = temp->next;
    }

    delete temp;

    cout << "\nStudent record deleted successfully!\n";
}

// Function to search student
void searchStudent()
{
    if (head == nullptr)
    {
        cout << "\nStudent list is empty!\n";
        return;
    }

    int rollNo;

    cout << "\nEnter Roll Number to search: ";
    cin >> rollNo;

    Student* temp = head;

    while (temp != nullptr)
    {
        if (temp->rollNo == rollNo)
        {
            cout << "\nStudent Found!\n";
            cout << "-------------------------\n";
            cout << "Roll Number : " << temp->rollNo << endl;
            cout << "Name        : " << temp->name << endl;
            cout << "Marks       : " << temp->marks << endl;
            cout << "-------------------------\n";

            return;
        }

        temp = temp->next;
    }

    cout << "\nStudent record not found!\n";
}

// Function to display students
void displayStudents()
{
    if (head == nullptr)
    {
        cout << "\nStudent list is empty!\n";
        return;
    }

    Student* temp = head;

    cout << "\n========== Student Records ==========\n";

    while (temp != nullptr)
    {
        cout << "\nRoll Number : " << temp->rollNo;
        cout << "\nName        : " << temp->name;
        cout << "\nMarks       : " << temp->marks;
        cout << "\n-------------------------------------\n";

        temp = temp->next;
    }
}
// Main function
int main()
{
    int choice;
   do
    {
        cout << "\n\n===== Student Record Management =====\n";
        cout << "1. Insert Student\n";
        cout << "2. Delete Student\n";
        cout << "3. Search Student\n";
        cout << "4. Display Students\n";
        cout << "5. Exit\n";

        cout << "\nEnter your choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                insertStudent();
                break;

            case 2:
                deleteStudent();
                break;

            case 3:
                searchStudent();
                break;

            case 4:
                displayStudents();
                break;

            case 5:
                cout << "\nProgram terminated successfully.\n";
                break;

            default:
                cout << "\nInvalid choice! Please try again.\n";
        }

    } while (choice != 5);

    return 0;
}
